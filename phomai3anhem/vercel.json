{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/(css|js|images|assets)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/$1.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/api/index.php"
    }
  ]
}
